 {% endif %}\n\n  {% for k in options %}\n    {% set _ = options.update({k: render(options[k])}) %}\n  {% endfor %}\n\n  {# legacy top-level write options #}\n  {% if config.get(\'format\') %}\n    {% set _ = options.update({\'format\': render(config.get(\'format\'))}) %}\n  {% endif %}\n  {% if config.get(\'delimiter\') %}\n    {% set _ = options.update({\'delimiter\': render(config.get(\'delimiter\'))}) %}\n  {% endif %}\n\n  {% do return(options) %}\n{%- endmacro %}', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'config', 'type': None, 'description': ''}], 'created_at': 1795198383.6557527, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__apply_grants': {'name': 'duckdb__apply_grants', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros\\adapters.sql', 'original_file_path': 'macros\\adapters.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__apply_grants', 'macro_sql': "{% macro duckdb__apply_grants(relation, grant_config, should_revoke=True) %}\n    {#-- If grant_config is {} or None, this is a no-op --#}\n    {% if grant_config %}\n      {{ adapter.warn_once('Grants for relations are not supported by DuckDB') }}\n    {% endif %}\n{% endmacro %}", 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'relation', 'type': None, 'description': ''}, {'name': 'grant_config', 'type': None, 'description': ''}, {'name': 'should_revoke', 'type': None, 'description': ''}], 'created_at': 1795198383.6572714, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__get_catalog': {'name': 'duckdb__get_catalog', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros\\catalog.sql', 'original_file_path': 'macros\\catalog.sql', 'unique_id': 'macro.dbt_duckdb.duckdb__get_catalog', 'macro_sql': "{% macro duckdb__get_catalog(information_schema, schemas) -%}\n  {%- call statement('catalog', fetch_result=True) -%}\n    with relations AS (\n      select\n        t.table_name\n        , t.database_name\n        , t.schema_name\n        , 'BASE TABLE' as table_type\n        , {{ adapter.catalog_comment('t') }} as table_comment\n      from duckdb_tables() t\n      WHERE t.database_name = '{{ database }}'\n      UNION ALL\n      SELECT v.view_name as table_name\n      , v.database_name\n      , v.schema_name\n      , 'VIEW' as table_type\n      , {{ adapter.catalog_comment('v') }} as table_comment\n      from duckdb_views() v\n      WHERE v.database_name = '{{ database }}'\n    )\n    select\n        '{{ database }}' as table_database,\n        r.schema_name as table_schema,\n        r.table_name,\n        r.table_type,\n        r.table_comment,\n        c.column_name,\n        c.column_index as column_index,\n        c.data_type as column_type,\n        {{ adapter.catalog_comment('c') }} as column_comment,\n        '' as table_owner\n    FROM relations r JOIN duckdb_columns() c ON r.schema_name = c.schema_name AND r.table_name = c.table_name\n    WHERE (\n        {%- for schema in schemas -%}\n          upper(r.schema_name) = upper('{{ schema }}'){%- if not loop.last %} or {% endif -%}\n        {%- endfor -%}\n    )\n    ORDER BY\n        r.schema_name,\n        r.table_name,\n        c.column_index\n  {%- endcall -%}\n  {{ return(load_result('catalog').table) }}\n{%- endmacro %}", 'depends_on': {'macros': ['macro.dbt.statement']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'information_schema', 'type': None, 'description': ''}, {'name': 'schemas', 'type': None, 'description': ''}], 'created_at': 1795198383.6582906, 'supported_languages': None}, '